                                                    <a href="https://southcarolinaparks.com/may-forest" class="park-link-dropdown">May Forest State Park</a>
                                                    <a href="https://southcarolinaparks.com/myrtle-beach" class="park-link-dropdown">Myrtle Beach State Park</a>
                                                    <a href="https://southcarolinaparks.com/oconee" class="park-link-dropdown">Oconee State Park</a>

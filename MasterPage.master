        <!-- Account and staff admin menu (sign in/out, edit, admin links). Kept outside the header element
             so the site's "body header ..." rules don't restyle the Bootstrap dropdowns. -->
        <div class="sc-account-nav noprint" role="navigation" aria-label="Account Links">

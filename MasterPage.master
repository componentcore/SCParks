<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs"
    Inherits="MasterPage" %>

<%@ Register TagPrefix="uc1" TagName="UCMasterPageFooter" Src="MasterFooter.ascx" %>
<%@ Register TagPrefix="Item" Namespace="ManagementSuite.Web.UI.Controls" Assembly="ManagementSuite.Web" %>
<%@ Register TagPrefix="Bootstrap" TagName="Menu" Src="/Core/Item/Menu/BootstrapMenu.ascx" %>
<% if (PUP.IsMode("m"))
    { // Allows mobile device to use narrow browser width. %>
<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE html PUBLIC "-//WAPFORUM//DTD XHTML Mobile 1.0//EN" "http://www.wapforum.org/DTD/xhtml-mobile10.dtd">
<% }
    else
    { %>
<!DOCTYPE html>
<% } %>
<html class="no-js" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="IE=edge" />
    <meta name="description" content="With more than 90,000 acres of protected lands stretching from the Blue Ridge Mountains to the sand dunes of the Atlantic Ocean, South Carolina state parks protect some of the most inviting natural, cultural and recreational destinations in the country." />
    <meta property="og:image" content="https://southcarolinaparks.com/images/og/south-carolina-parks.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <title>South Carolina Parks | South Carolina Parks Official Site</title>
    <link type="image/ico" href="/scparks/favicon.ico" rel="shortcut icon" />

    <!-- Core styles (shared with all sites) -->
    <link type="text/css" rel="stylesheet" href="/core/css/materialicons/icon.css" />
    <link type="text/css" rel="stylesheet" href="/core/css/default.css" />

    <!-- South Carolina Parks styles, from the southcarolinaparks.com inline style block (fonts and header/footer images served from /scparks/) -->
    <%-- href set in code-behind with a file-date version (no code blocks allowed in head: controls get added to it) --%>
    <link id="ScParksCssLink" runat="server" type="text/css" rel="stylesheet" href="/scparks/css/scparks.css" />

    <style>
        /* The "+" expanders on Camping & Lodging, See & Do and Education & History load their submenus from
           southcarolinaparks.com's /api/menu/, which currently returns an empty list (the live site opens an
           empty panel with only a "SEE FULL PAGE" link). Hide them; each top-level link goes to its section page. */
        header #main-nav li:not(.parks-menu-item) .menu-expand {
            display: none !important;
        }

        /* Parks dropdown (narrow widths): the source site only renders this list while open. */
        header .parks-menu-item:not(.park-finder-menu-item-active) .parks-dropdown {
            display: none;
        }

        /* /core/css/default.css has a generic .box rule (padding:10px; border) that the SC header's social
           icon markup (.box.icons, .box.icon, .box.share) also matches. SC's own CSS sets neither. */
        .sticky-header .box {
            padding: 0;
            border: 0;
        }

        /* Account/admin menu (BootstrapMenu.ascx) placed over the right end of the green utility bar */
        .sc-account-nav {
            position: absolute;
            top: 0;
            right: 0;
            height: 45px;
            display: flex;
            align-items: center;
            padding-right: 8px;
            z-index: 10000;
        }

            .sc-account-nav #globalNav {
                margin: 0;
                padding: 0;
                height: auto;
                line-height: normal;
                width: auto;
            }

            /* BootstrapMenu reserves 125px inline and floats its icon groups right; in this shrink-to-fit box the
               floats wrap vertically, so lay them out as a row instead. row-reverse keeps the float-right order
               (first group, the gear, rightmost). */
            .sc-account-nav .nav-collapse {
                min-width: 0 !important;
                float: none !important;
                display: flex !important;
                flex-direction: row-reverse;
                align-items: center;
            }

                .sc-account-nav .nav-collapse > ul.nav {
                    float: none !important;
                    margin: 0;
                }

            .sc-account-nav .navbar {
                margin: 0;
                min-height: 0;
                border: 0;
                background: transparent;
            }

            /* BootstrapMenu gives .navbar-inner a 10px top margin, and an inline icon with a 30px line-height
               adds space below the glyph. Both pushed the icons ~4px below the social icons' center line. */
            .sc-account-nav .navbar-inner {
                margin: 0;
            }

            .sc-account-nav .button-topbar {
                display: block;
                color: #485b24;
                font-size: 26px;
                line-height: 26px;
                height: 26px;
                padding: 0 3px;
                cursor: pointer;
            }

                .sc-account-nav .button-topbar:hover {
                    color: #fff;
                }

            .sc-account-nav .dropdown-menu {
                text-align: left;
            }

        @media (min-width: 992px) {
            #utility-nav {
                padding-right: 80px; /* room for .sc-account-nav */
            }
        }

        @media (max-width: 991px) {
            .sticky-header {
                position: relative; /* fixed (positioned) at 992px+ in scparks.css */
            }

            .sc-account-nav {
                right: 4px; /* right of the hamburger button */
                height: 60px;
            }

                .sc-account-nav .button-topbar {
                    color: #fff;
                }
        }

        /* Page body. SC's .content rule (centered text, 1500px cap, paper background, top margin for the
           fixed header) applies to the master's <main> only, not to .content elements inside pages. */
        main.content {
            text-align: left;
        }

        main.content .main-container {
            padding-top: 20px;
            padding-bottom: 30px;
        }

        /* Page text matches SC's link color (a{color:#9e5700} in scparks.css). Without this, text in plain
           divs and headings falls back to Bootstrap's body #333, p/ul/li/span use SC's #916f46, and page/item
           titles use /core/css/default.css .itemtitle #656544, .pagetitle #545454 and .sectionbar #585846.
           Table cells and the labels inside them use scparks.css table,td #916f46.
           Buttons and form fields keep their own colors. .extraLinks is the staff-only "Static Page | Dynamic"
           bar below the content, whose "|" separators are plain text in a default.css .mainBox (#555). */
        main.content .main-container,
        main.content .main-container p,
        main.content .main-container ul,
        main.content .main-container li,
        main.content .main-container span,
        main.content .main-container table,
        main.content .main-container td,
        main.content .main-container th,
        main.content .main-container label,
        main.content .main-container .itemtitle,
        main.content .main-container .pagetitle,
        main.content .main-container .sectionbar,
        main.content .extraLinks {
            color: #9e5700;
        }

        /* default.css .sectionbar underline is gray (#777). */
        main.content .main-container .sectionbar {
            border-bottom-color: #9e5700;
        }

        /* Filled section bar with an inline gray background and white text, e.g. the staff-only "Assignment"
           bar on /location/request/app.aspx. */
        main.content .main-container .sectionbar[style*="#757575"] {
            background-color: #9e5700 !important;
        }

            main.content .main-container .sectionbar[style*="#757575"] span {
                color: #fff;
            }

        /* Gray dividers in brown tints of the text color, so they stay subtle on the paper background:
           default.css .line row separators (#ddd), scparks.css hr (#eee), and boxes with an inline
           "border:1px solid #aaa" or "#ccc", such as the Payment History / Approved Assignments box on
           /location/request/detail.aspx and the Assignment box on app.aspx (inline style, hence !important). */
        main.content .main-container .line {
            background-color: rgba(158, 87, 0, .25);
        }

        main.content .main-container hr {
            border-top-color: rgba(158, 87, 0, .25);
        }

        main.content .main-container div[style*="solid #aaa"],
        main.content .main-container div[style*="solid #ccc"],
        main.content .main-container td[style*="solid #aaa"] {
            border-color: rgba(158, 87, 0, .5) !important;
        }

        /* 2px divider tables on the host timeline (/volunteer/hosts) with an inline #CCCCCC background. */
        main.content .main-container table[style*="background:#CCCCCC"] {
            background: rgba(158, 87, 0, .5) !important;
        }

        /* 1px row separators on /location/request/list.aspx are table cells with an inline #777 background. */
        main.content .main-container td[style*="background-color:#777"] {
            background-color: rgba(158, 87, 0, .5) !important;
        }

        /* Gray/blue panel and row backgrounds from /location/request/list.aspx's own <style> block, in light
           brown tints: the filter panel (#eee) and the rows for applicants pending at the selected park
           (#eef/#eaeaff/#e6e6ff, kept light to dark). */
        main.content .main-container .listSearchBox {
            background-color: rgba(158, 87, 0, .08);
        }

        main.content .main-container .pendingAtLocTop {
            background-color: rgba(158, 87, 0, .06);
        }

        main.content .main-container .pendingAtLoc {
            background-color: rgba(158, 87, 0, .08);
        }

        main.content .main-container .pendingAtLocBottom {
            background-color: rgba(158, 87, 0, .10);
        }

        /* Host timeline (/volunteer/hosts, Location/Request/HostTimeline.aspx) styles from its own <style>
           block: the search panel (#dfdfdf), its "pending within..." box (#ddd header, #333 row lines, #eef
           rows for the selected park), the park title bar (#555, white text) and the "Add Opening" footer
           bar (#ccc). */
        main.content .main-container .searchCriteriaBox {
            background-color: rgba(158, 87, 0, .08);
        }

        main.content .main-container .recentPendingHeaderCell {
            background: rgba(158, 87, 0, .10);
        }

        main.content .main-container .recentPendingRowCell {
            border-bottom-color: rgba(158, 87, 0, .5);
        }

        main.content .main-container .recentPendingRowCell-primary {
            background: rgba(158, 87, 0, .08);
        }

        main.content .main-container .orgHeaderBar {
            background: #9e5700;
        }

        main.content .main-container .orgFooterBar {
            background: rgba(158, 87, 0, .15);
        }

        /* Outlined "edit"/"apply" buttons (default.css .textbutton): blue link text and an olive-gray border,
           with a gray hover. The host timeline's own <style> block sets the blue text and the gray hover
           with !important, hence !important here. */
        main.content .main-container .textbutton {
            color: #9e5700 !important;
            border-color: rgba(158, 87, 0, .5);
        }

            main.content .main-container .textbutton:hover {
                color: #9e5700 !important;
                border-color: #9e5700;
                background-color: rgba(158, 87, 0, .12) !important;
            }

        /* Form controls: scparks.css makes inputs and selects inherit the text color but not textareas,
           which stay browser-default black. accent-color turns checked checkboxes and radio buttons from
           the browser's default blue to the text color. */
        main.content .main-container textarea {
            color: inherit;
        }

        main.content .main-container input[type="checkbox"],
        main.content .main-container input[type="radio"] {
            accent-color: #9e5700;
        }

        /* Many core, Net and Location/Request pages hard-code <img src="/core/img/arrows/rect-blue.gif">,
           rect-green.gif or rect-olive.gif as a link bullet. On SC pages, swap them for rect-brown.gif, the
           same arrow in the text/link color (#9e5700), instead of editing each page. */
        img[src$="/core/img/arrows/rect-blue.gif"],
        img[src$="/core/img/arrows/rect-green.gif"],
        img[src$="/core/img/arrows/rect-olive.gif"] {
            content: url(/core/img/arrows/rect-brown.gif);
        }

        main.content .main-container .content {
            width: auto;
            max-width: inherit;
            margin: inherit;
            text-align: inherit;
            background-image: none;
        }

        .contentpadding {
            padding-top: inherit;
            padding-left: inherit;
            padding-right: inherit;
            padding-bottom: inherit;
        }

        label {
            font-weight: normal;
            display: inline;
        }

        input[type="radio"], input[type="checkbox"] {
            margin: 4px 3px 0;
        }

        /* Skip link: hidden until focused by keyboard */
        #skipLink {
            position: absolute;
            left: -10000px;
            top: 0;
            z-index: 10001;
            padding: 6px 12px;
            background: #fff;
        }

            #skipLink:focus {
                left: 0;
            }

        /* Simple logo-only header for a/e/p modes (admin, email, print) */
        .sc-simple-header {
            padding: 10px 15px;
            background-color: #485b24;
        }

            .sc-simple-header img {
                max-height: 70px;
            }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
    <asp:PlaceHolder ID="StyleOverridePH" runat="server"></asp:PlaceHolder>
    <!-- [HEADHOOK] -->
</head>
<body>
    <% if (!PUP.IsMode("aep"))
        { %>
    <div id="skip-link" role="navigation" aria-labelledby="skipLink">
        <a href="#main-content" id="skipLink">Skip to main content</a>
    </div>

    <!-- Begin Header (from https://southcarolinaparks.com/) -->
    <div class="sticky-header no-print">
        <header>
            <div>
                <div>
                    <nav class="navbar navbar-default navbar-static-top">
                        <div class="container top-navbar-container">
                            <div class="navbar-header">
                                <button type="button" aria-label="Search" class="search-button search-button-mobile"><i class="fa fa-search"></i></button>
                                <a href="https://southcarolinaparks.com/"><img src="/scparks/images/scp-mobile-logo.svg" alt="Come out and play" class="img-responsive mobile-image"></a>
                                <button type="button" id="no-hover-navbar" aria-label="SCP Navbar Collapse" aria-controls="header-collapse" aria-expanded="false" class="navbar-toggle"><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button>
                            </div>
                            <div id="header-collapse" class="navbar-collapse collapse">
                                <div class="navbar-container">
                                    <a href="https://southcarolinaparks.com/" aria-label="Home" class="header-logo-link">
                                        <div id="homepage-image" class="nav navbar-nav"><img src="/scparks/images/south-carolina-parks-logo.png" alt="Come out and play"></div>
                                    </a>
                                    <div class="navbar-section">
                                        <ul id="main-nav" class="nav navbar-nav">
                                            <li class="park-finder-li park-finder-menu-item"><a href="https://southcarolinaparks.com/park-finder">Park Finder</a></li>
                                            <%-- Parks dropdown: the list below shows under 992px wide; at 992px+ the panel in #park-finder-cta-component
                                                 (end of the header) shows instead. Both are toggled by scripts/header.js. The park list is hard-coded,
                                                 as it is in southcarolinaparks.com's own header script. --%>
                                            <li class=" parks-menu-item">
                                                <div style="cursor: pointer;" class="sc-parks-toggle" role="button" tabindex="0" aria-expanded="false" aria-controls="park-finder-cta-component"><span class="header__parks-dropdown-title">Parks</span><span class="menu-expand menu-expand-first">+</span><img src="/scparks/images/park-listing.png" alt="Park finder dropdown" class="img-responsive">
                                                <div class="parks-dropdown">
                                                    <a href="https://southcarolinaparks.com/aiken" class="park-link-dropdown">Aiken State Park</a>
                                                    <a href="https://southcarolinaparks.com/andrew-jackson" class="park-link-dropdown">Andrew Jackson State Park</a>
                                                    <a href="https://southcarolinaparks.com/baker-creek" class="park-link-dropdown">Baker Creek State Park</a>
                                                    <a href="https://southcarolinaparks.com/barnwell" class="park-link-dropdown">Barnwell State Park</a>
                                                    <a href="https://southcarolinaparks.com/musgrove-mill" class="park-link-dropdown">Battle of Musgrove Mill State Historic Site</a>
                                                    <a href="https://southcarolinaparks.com/rivers-bridge" class="park-link-dropdown">Battle of Rivers Bridge State Historic Site</a>
                                                    <a href="https://southcarolinaparks.com/black-river" class="park-link-dropdown">Black River State Park</a>
                                                    <a href="https://southcarolinaparks.com/caesars-head" class="park-link-dropdown">Caesars Head State Park</a>
                                                    <a href="https://southcarolinaparks.com/calhoun-falls" class="park-link-dropdown">Calhoun Falls State Park</a>
                                                    <a href="https://southcarolinaparks.com/charles-towne-landing" class="park-link-dropdown">Charles Towne Landing State Historic Site</a>
                                                    <a href="https://southcarolinaparks.com/cheraw" class="park-link-dropdown">Cheraw State Park</a>
                                                    <a href="https://southcarolinaparks.com/chester" class="park-link-dropdown">Chester State Park</a>
                                                    <a href="https://southcarolinaparks.com/colleton" class="park-link-dropdown">Colleton State Park</a>
                                                    <a href="https://southcarolinaparks.com/colonial-dorchester" class="park-link-dropdown">Colonial Dorchester State Historic Site</a>
                                                    <a href="https://southcarolinaparks.com/croft" class="park-link-dropdown">Croft State Park</a>

                                                    <a href="https://southcarolinaparks.com/table-rock" class="park-link-dropdown">Table Rock State Park</a>
                                                    <a href="https://southcarolinaparks.com/woods-bay" class="park-link-dropdown">Woods Bay State Park</a>
                                                </div></div>
                                            </li>
                                            <li class="camping-and-lodging-menu-item"><a href="https://southcarolinaparks.com/camping-and-lodging">Camping &amp; Lodging</a><span class="menu-expand menu-expand-first">+</span></li>
                                            <li class="see-and-do-menu-item"><a href="https://southcarolinaparks.com/see-and-do">See &amp; Do</a><span class="menu-expand menu-expand-first">+</span></li>
                                            <li class="education-and-history-menu-item"><a href="https://southcarolinaparks.com/education-and-history">Education &amp; History</a><span class="menu-expand menu-expand-first">+</span></li>

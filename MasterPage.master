        else
        { %>
    <div class="sc-simple-header">
        <a href="https://southcarolinaparks.com/"><img src="/scparks/images/south-carolina-parks-logo.png" alt="South Carolina State Parks" /></a>
    </div>
    <% } %>
    <asp:PlaceHolder ID="BesideLogoAdminPH" runat="server"></asp:PlaceHolder>

    <main class="content">
        <%-- UtilityPage (net/) templates split this master page's rendered HTML on these marker comments
             (Net/Engine/Core/Template.cs): the lines from LAYOUT through END LAYOUT are replaced by the
             UtilityPage's own content. Keep each marker on its own line, and keep them inside <main> so the
             fixed-header offset and paper background still apply to UtilityPage content. --%>
    <!-- LAYOUT -->
    <!-- PAGE BODY -->
    <!-- CONTENT -->
        <form id="form1" runat="server">
            <!-- Begin Main Container -->
            <div class="main-container container" role="main">
                <asp:Literal ID="SessionMessageLiteral" runat="server"></asp:Literal>
                <a id="main-content"></a>
                <Item:FlushPoint id="ShellFlushPoint" runat="server" />
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <!-- End Main Container -->
        </form>
        <asp:Literal ID="ExtrasLiteral" runat="server"></asp:Literal>
        <Item:BlurbList ID="MasterBlurbList" runat="server"></Item:BlurbList>
    <!-- END CONTENT -->
    <!-- END PAGE BODY -->
    <!-- END LAYOUT -->
    </main>

    <!-- Begin Footer (from https://southcarolinaparks.com/) -->
    <footer>
        <div class="footer-container">
            <% if (!PUP.IsMode("e"))
                { %>
            <div class="upper-footer">
                <div class="row logos-row">
                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xl-4 double-image-column">
                        <a href="https://southcarolinaparks.com/"><img src="/scparks/images/play.png" alt="Come out and play" class="img-responsive" /></a>
                        <a href="https://southcarolinaparks.com/"><img src="/scparks/images/sc-parks-check-footer.png" alt="SC Parks Check" class="img-responsive" width="76" height="60" /></a>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xl-4 footer-social">
                        <a href="https://www.facebook.com/SC.State.Parks" target="_blank" rel="noopener">
                            <svg role="img" aria-label="Facebook" class="footer-social-icon footer-social-icon--facebook">
                                <use href="/scparks/images/icons/facebook.svg#facebook"></use>
                            </svg>
                        </a>
                        <a href="https://x.com/SC_State_Parks" target="_blank" rel="noopener">
                            <svg role="img" aria-label="Twitter" class="footer-social-icon footer-social-icon--twitter">
                                <use href="/scparks/images/icons/twitter.svg#twitter"></use>
                            </svg>
                        </a>
                        <a href="https://www.pinterest.com/scstateparks/" target="_blank" rel="noopener">
                            <svg role="img" aria-label="Pinterest" class="footer-social-icon footer-social-icon--pinterest">
                                <use href="/scparks/images/icons/pinterest.svg#pinterest"></use>
                            </svg>
                        </a>
                        <a href="https://www.instagram.com/scstateparks/" target="_blank" rel="noopener">
                            <svg role="img" aria-label="Instagram" class="footer-social-icon footer-social-icon--instagram">
                                <use href="/scparks/images/icons/instagram.svg#instagram"></use>
                            </svg>
                        </a>
                        <a href="https://www.youtube.com/user/SCStateParks" target="_blank" rel="noopener" aria-label="youtube">
                            <svg role="img" aria-label="YouTube" class="footer-social-icon footer-social-icon--youtube">
                                <use href="/scparks/images/icons/youtube.svg#youtube"></use>
                            </svg>
                        </a>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xl-4 sc-logo-column">
                        <a href="https://discoversouthcarolina.com" target="_blank" rel="noopener"><img src="/scparks/images/discover-south-carolina-logo--brown.png" alt="South Carolina logo" class="img-responsive" /></a>
                    </div>
                </div>
                <div class="row text-row">
                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xl-4 text-row-left-column">
                        <div class="text-wrapper">
                            <h3>South Carolina State Parks</h3>
                            <a class="footer__link" href="https://pages.discoversouthcarolina.travel/parks-contact" target="_blank" rel="noopener">Contact Us</a>
                            <a class="footer__link parks-contact" href="https://scmediaroom.com/contact" target="_blank" rel="noopener">Journalists &amp; Influencers</a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xl-4 text-row-middle-column">
                        <div class="text-wrapper">
                            <a class="footer__link" href="https://southcarolinaparks.com/faqs">FAQ's</a>
                            <a class="footer__link" href="https://southcarolinaparks.com/recycling">Recycling</a>
                            <a class="footer__link" href="https://www.scprt.com/parks/jobs-at-state-parks" target="_blank" rel="noopener">Careers</a>
                            <a class="footer__link" href="https://southcarolinaparks.com/volunteer">Volunteers</a>
                            <a class="footer__link" href="https://southcarolinaparks.com/rules-regulations">Rules &amp; Regulations</a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 col-xl-4 text-row-right-column">
                        <div class="text-wrapper">
                            <a class="footer__link" href="https://reserve.southcarolinaparks.com/" target="_blank" rel="noopener">Make a Reservation</a>
                            <a class="footer__link" href="https://www.scprt.com/parks/donate-to-state-parks" target="_blank" rel="noopener">Donate</a>
                            <a class="footer__link" href="https://www.scprt.com/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>
                            <a class="footer__link" href="https://www.scprt.com/accessibility" target="_blank" rel="noopener">Accessibility</a>
                            <a class="footer__link" href="https://www.scprt.com/legal" target="_blank" rel="noopener">Legal</a>
                            <a class="footer__link" href="https://southcarolinaparks.com/education-and-history/state-house">South Carolina State House</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bottom-footer">
                <div class="row mini-footer-top">
                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-3 col-xl-3 newsletter"><a href="https://pages.discoversouthcarolina.travel/parks-news" target="_blank" rel="noopener">Sign up to receive the Newsletter</a></div>
                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-3 col-xl-3 discover"><a href="https://discoversouthcarolina.com" target="_blank" rel="noopener">DiscoverSouthCarolina.com</a></div>
                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-3 col-xl-3 scprt"><a href="https://www.scprt.com" target="_blank" rel="noopener">SCPRT.com</a></div>
                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-3 col-xl-3 alliance"><a href="https://southcarolinaparks.com/beautiful-places-alliance">Beautiful Places Alliance</a></div>
                </div>
            </div>
            <% } %>
            <!-- Account and staff links (sign in/out, volunteer account, admin tools) by access level -->
            <uc1:UCMasterPageFooter ID="UCMasterPageFooter1" runat="server"></uc1:UCMasterPageFooter>
            <div class="footer-copyright-container">
                <div class="mini-footer-bottom">
                    Copyright <%= DateTime.Now.Year %>, South Carolina Department of Parks, Recreation &amp; Tourism. All Rights Reserved.
                </div>
            </div>
        </div>
    </footer>
    <!-- End Footer -->

    <%-- southcarolinaparks.com's React header/footer bundle (https://southcarolinaparks.com/scripts/common) isn't
         used: it re-renders the header (removing the merged BootstrapMenu) and calls /api/menu/ on this host, so
         header.js reproduces just the behaviors the static header needs. --%>
    <script src="<%= VersionedUrl("/scparks/scripts/header.js") %>"></script>
    <script>
        // BootstrapMenu's person/gear icons need a dropdown plugin. BootstrapMenu.ascx.cs includes
        // /core/js/bootstrap-dropdown.js for most sites but not for the GeorgiaDNR group (Version 2), whose
        // Parks master loads Bootstrap 3 instead. Load it here only when no dropdown plugin is present, since
        // loading two would toggle each menu open and closed on the same click.
        if (window.jQuery && !jQuery.fn.dropdown) {
            document.write('<script src="/core/js/bootstrap-dropdown.js"><\/script>');
        }
    </script>

    <script type="text/javascript">
<!--
    $(function () {
     <% // See if a template page (UtilityPage) is loaded. If so, move the skip content link target and masterMessageArea span,
        // if present, from the asp.net generated aspnetForm to just before the page form. %>
        var $divRoleMain = $('div[role="main"]');
        if ($divRoleMain.length == 2) {
            $divRoleMain.each(function (index, element) {
                var $this = $(this);
                if ($this.closest('#aspnetForm').length == 1) {
                    var targetIndex = index == 0 ? 1 : 0;
                    var $target = $($divRoleMain[targetIndex]);
                    if ($target.find('#main-content').length == 0) {
                        $this.find('#main-content').prependTo($target);
                    }
                    if ($target.find('span.masterMessageArea').length == 0) {
                        $this.find('span.masterMessageArea').prependTo($target);
                    }
                    $this.removeAttr("role");
                }
            });
        }
    });

    function loadUserAccessCustom(userState) { // Called by /core/item/scripts/util.js
        if ($("div.sideMenuColumn").length > 0) {
            var relationAccess = Math.max(userState.relationAccess, userState.partnerAccess);
            if ((userState.userAccess >= 4 || relationAccess >= 4) && itemID > 0) {
                // Override the masterpage styles for the edit menu
                $(".main-container.container").css({
                    "margin-left": "0px",
                    "margin-right": "0px",
                    "padding-right": "0px",
                    "padding-left": "0px",
                    "width": "auto"
                });
            }
        }
    }
//-->
    </script>
</body>
</html>

                                            <div class="box icon-wrapper">
                                                <div class="box icons">
                                                    <div class="box icon"><a href="https://www.facebook.com/SC.State.Parks" target="_blank" rel="noopener"><svg role="img" aria-label="Facebook" class="header-social-icon header-social-icon--facebook"><use href="/scparks/images/icons/facebook.svg#facebook"></use></svg></a></div><div class="box icon"><a href="https://x.com/SC_State_Parks" target="_blank" rel="noopener"><svg role="img" aria-label="Twitter" class="header-social-icon header-social-icon--twitter"><use href="/scparks/images/icons/twitter.svg#twitter"></use></svg></a></div><div class="box icon"><a href="https://www.pinterest.com/scstateparks/" target="_blank" rel="noopener"><svg role="img" aria-label="Pinterest" class="header-social-icon header-social-icon--pinterest"><use href="/scparks/images/icons/pinterest.svg#pinterest"></use></svg></a></div><div class="box icon"><a href="https://www.instagram.com/scstateparks/" target="_blank" rel="noopener"><svg role="img" aria-label="Instagram" class="header-social-icon header-social-icon--instagram"><use href="/scparks/images/icons/instagram.svg#instagram"></use></svg></a></div><div class="box icon"><a href="https://www.youtube.com/user/SCStateParks" target="_blank" rel="noopener"><svg role="img" aria-label="Youtube" class="header-social-icon header-social-icon--youtube"><use href="/scparks/images/icons/youtube.svg#youtube"></use></svg></a></div>
                                                </div>
                                                <div class="box share"><a href="#" aria-label="Social Icons Animation" class="shareiconmini"><i aria-hidden="true" class="icono-share"></i></a></div>
